{
  "compilerOptions": {
    "rootDir": "./src",        // Location of TypeScript code
    "outDir": "./dist",       // Compile output location for JavaScript code

    "module": "nodenext",
    "target": "esnext",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"]     // src directory is included for compilation
}